<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Appium.WebDriver" Version="9.0.0" />
    <!-- Pinned on its own, as the Appium client advises, so a restore never picks a newer Selenium than the one the client was built against. -->
    <PackageReference Include="Selenium.WebDriver" Version="4.46.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- One file per import format, pushed to the device and picked through the system picker. -->
    <None Include="..\TestFixtures\Examples\example.*" Link="Fixtures\Examples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestFixtures\Importers\GoogleKeep\takeout.zip" Link="Fixtures\Importers\takeout.zip" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestFixtures\Importers\Loop\Phone\backup.db" Link="Fixtures\Importers\loop-backup.db" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestFixtures\Importers\Loop\Phone\export.zip" Link="Fixtures\Importers\loop-export.zip" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestFixtures\Importers\HabitNow\backup-frequency-tracks.hn" Link="Fixtures\Importers\habitnow.hn" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestFixtures\Importers\Habitica\userdata.json" Link="Fixtures\Importers\habitica.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestFixtures\Importers\Habitify\backup.db" Link="Fixtures\Importers\habitify.db" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <Using Include="OpenQA.Selenium" />
    <Using Include="OpenQA.Selenium.Appium" />
  </ItemGroup>

</Project>
