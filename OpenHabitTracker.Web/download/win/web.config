<?xml version="1.0" encoding="utf-8"?>
<!-- IIS returns 404 for extensions it has no MIME type for, and the Velopack feed is .nupkg files -->
<configuration>
  <system.webServer>
    <staticContent>
      <mimeMap fileExtension=".nupkg" mimeType="application/octet-stream" />
    </staticContent>
  </system.webServer>
</configuration>
