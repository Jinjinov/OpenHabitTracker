@inject IAssemblyProvider AssemblyProvider

<Router AppAssembly="@AssemblyProvider.AppAssembly" AdditionalAssemblies="@AssemblyProvider.AdditionalAssemblies">
    <Found Context="routeData">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
            </ChildContent>
            <ErrorContent Context="Exception">
                <ErrorComponent Exception="Exception" OnRetry="Retry" />
            </ErrorContent>
        </ErrorBoundary>
    </Found>
    <NotFound>
        <p role="alert">Sorry, there's nothing at this address.</p>
    </NotFound>
</Router>

@code {
    private ErrorBoundary? _errorBoundary;

    private void Retry() => _errorBoundary?.Recover();
}
