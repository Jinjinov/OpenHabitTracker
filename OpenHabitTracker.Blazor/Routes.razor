@using System.Net.Http

@inject IAssemblyProvider AssemblyProvider

<Router AppAssembly="@AssemblyProvider.AppAssembly" AdditionalAssemblies="@AssemblyProvider.AdditionalAssemblies">
    <Found Context="routeData">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
            </ChildContent>
            <ErrorContent Context="Exception">
                @if (IsServerError(Exception))
                {
                    <p role="alert">Cannot reach the server.</p>
                    <button class="btn btn-primary" @onclick="Retry">Retry</button>
                }
                else
                {
                    <p role="alert">Something went wrong.</p>
                    <details>
                        <summary>Details</summary>
                        <pre>@Exception.ToString()</pre>
                    </details>
                }
            </ErrorContent>
        </ErrorBoundary>
    </Found>
    <NotFound>
        <p role="alert">Sorry, there's nothing at this address.</p>
    </NotFound>
</Router>

@code {
    private ErrorBoundary? _errorBoundary;

    // ApiException lives in the API client project, which this one does not reference.
    private static bool IsServerError(Exception exception) =>
        exception is HttpRequestException || exception.GetType().Name == "ApiException";

    private void Retry() => _errorBoundary?.Recover();
}
