@using GTour.Abstractions
@using OpenHabitTracker.App
@using OpenHabitTracker.Backup
@using OpenHabitTracker.Blazor.Files

@inject ImportExportService ImportExportService
@inject ClientState ClientState
@inject IOpenFile OpenFile
@inject ISaveFile SaveFile
@inject IStringLocalizer Loc
@inject ILinkAttributeService LinkAttributeService
@inject IGTourService GTourService

<div @ref="WrapperElement">

    <small class="m-1"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> @Loc["Import / Export"]</small>

    <div class="my-1">

        <div class="list-group">
            <button class="list-group-item list-group-item-action" @onclick="() => ExportFile(FileFormat.Json)" data-data-step-3><i class="bi bi-box-arrow-right" aria-hidden="true"></i> @Loc["Export JSON"]</button>
            <button class="list-group-item list-group-item-action" @onclick="() => ExportFile(FileFormat.Tsv)" data-data-step-4><i class="bi bi-box-arrow-right" aria-hidden="true"></i> @Loc["Export TSV"]</button>
            <button class="list-group-item list-group-item-action" @onclick="() => ExportFile(FileFormat.Yaml)" data-data-step-5><i class="bi bi-box-arrow-right" aria-hidden="true"></i> @Loc["Export YAML"]</button>
            <button class="list-group-item list-group-item-action" @onclick="() => ExportFile(FileFormat.Md)" data-data-step-6><i class="bi bi-box-arrow-right" aria-hidden="true"></i> @Loc["Export Markdown"]</button>

            @OpenFile.OpenFileDialog("list-group-item list-group-item-action", Loc["Import"], OnFileOpened)
        </div>

        @if (_pendingImport is not null)
        {
            <ImportSummary PendingImport="_pendingImport" OnImport="ConfirmImport" OnCancel="CancelImport" />
        }

        @if (_importResult == ImportResult.UnsupportedFormat)
        {
            <small class="d-block m-1 text-danger" role="alert">@Loc["The file is not in a supported format."]</small>
        }
        else if (_importResult == ImportResult.UnreadableContent)
        {
            <small class="d-block m-1 text-danger" role="alert">@Loc["The file could not be read."]</small>
        }

    </div>

    <div class="m-1">
        <small>@Loc["Import"]:</small>
        <ul>
            <li data-data-step-7><small>JSON (.json)</small></li>
            <li data-data-step-8><small>TSV (.tsv)</small></li>
            <li data-data-step-9><small>YAML (.yaml)</small></li>
            <li data-data-step-10><small>Markdown (.md)</small></li>
            <li data-data-step-11><small><a href="https://takeout.google.com/">Google Keep (.zip)</a></small></li>
            @* The browser ships no SQLite, so it reads no databases. *@
            <li data-data-step-12><small>@(OperatingSystem.IsBrowser() ? "Loop Habit Tracker (.zip)" : "Loop Habit Tracker (.db, .zip)")</small></li>
            <li data-data-step-13><small>HabitNow (.hn)</small></li>
            <li data-data-step-14><small><a href="https://habitica.com/export/userdata.json">Habitica (.json)</a></small></li>
            @if (!OperatingSystem.IsBrowser())
            {
                <li data-data-step-15><small>Habitify (.db)</small></li>
            }
        </ul>
    </div>

    @* @_filename

    <pre>@_fileContent</pre> *@

</div>

@if (ClientState.Settings.ShowHelp)
{
    <GuidedTourComponent TourId="importexport" TourSteps="tourSteps" />
}

@code {
    TourStep[] tourSteps =
    {
    };

    private async Task StartTour(string tourId)
    {
        await InvokeAsync(() => GTourService.StartTour(tourId));
    }

    [Parameter]
    public bool StateChanged { get; set; }

    [Parameter]
    public EventCallback<bool> StateChangedChanged { get; set; }

    string _filename = string.Empty;

    string _fileContent = string.Empty;

    ImportResult? _importResult;

    PendingImport? _pendingImport;

    private ElementReference WrapperElement;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LinkAttributeService.AddAttributesToLinks(WrapperElement);
        }
    }

    async Task OnStateChanged()
    {
        StateChanged = !StateChanged;
        await StateChangedChanged.InvokeAsync(StateChanged);
    }

    private async Task ExportFile(FileFormat fileFormat)
    {
        _fileContent = await ImportExportService.GetDataExportFileString(fileFormat);

        string extension = fileFormat.ToString().ToLower();

        await SaveFile.SaveFileDialog($"OpenHabitTracker.{DateTime.Now:yyyyMMddHHmmss}.{extension}", _fileContent);
    }

    private async Task OnFileOpened(string filename, Stream stream)
    {
#if DEBUG
        _filename = filename;

        using MemoryStream memoryStream = new();

        await stream.CopyToAsync(memoryStream);
        memoryStream.Position = 0;

        using StreamReader streamReader = new(memoryStream);

        _fileContent = await streamReader.ReadToEndAsync();

        memoryStream.Position = 0;
        streamReader.DiscardBufferedData();

        StateHasChanged();

        stream = memoryStream;
#endif

        (_importResult, _pendingImport) = await ImportExportService.ReadDataFile(filename, stream);

        // The file picker's callback belongs to OpenFile, which is not a component, so nothing re-renders this one.
        StateHasChanged();
    }

    private async Task ConfirmImport()
    {
        if (_pendingImport is null)
            return;

        await ImportExportService.Import(_pendingImport);

        _pendingImport = null;

        await OnStateChanged();
    }

    private void CancelImport()
    {
        _pendingImport = null;
    }
}
