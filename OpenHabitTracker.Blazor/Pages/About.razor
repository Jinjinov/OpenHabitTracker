@using OpenHabitTracker.App
@using OpenHabitTracker.Services

@inject IStringLocalizer Loc
@inject ILinkAttributeService LinkAttributeService
@inject IAppReview AppReview

<div @ref="WrapperElement" class="px-0 px-md-1">
    <div class="my-1">

        <h1 class="h3"><span style="font-family: 'Caveat', cursive; font-size: 1.5em;">OpenHabitTracker</span></h1>

        <span>@Loc["Version"] @AppVersion.Current</span>

        <p><a href="https://openhabittracker.net">https://openhabittracker.net</a></p>

        @if (AppReview.IsSupported)
        {
            <p><button class="btn btn-outline-primary" @onclick="() => AppReview.RateOnStore()"><i class="bi bi-star" aria-hidden="true"></i> @Loc["Rate this app"]</button></p>
        }

        <ul>
            <li><i class="bi bi-github" aria-hidden="true"></i> <a href="https://github.com/Jinjinov/OpenHabitTracker">@Loc["OpenHabitTracker on GitHub"]</a></li>
            <li>@Loc["Available on Windows, Linux, Android, iOS, macOS, and as a web app"]</li>
        </ul>

        <h2 class="h5">@Loc["Contact"]:</h2>

        <ul>
            <li><i class="bi bi-github" aria-hidden="true"></i> <a href="https://github.com/Jinjinov/OpenHabitTracker/issues">@Loc["Report a bug or request a feature"]</a></li>
            <li><i class="bi bi-github" aria-hidden="true"></i> <a href="https://github.com/Jinjinov/OpenHabitTracker/discussions">@Loc["Ask a question"]</a></li>
            <li><i class="bi bi-reddit" aria-hidden="true"></i> <a href="https://www.reddit.com/r/OpenHabitTracker">@Loc["Post in r/OpenHabitTracker"]</a></li>
            <li><i class="bi bi-reddit" aria-hidden="true"></i> <a href="https://www.reddit.com/user/Jinjinov">@Loc["Message me on Reddit"]</a></li>
        </ul>

        <h2 class="h5">@Loc["Privacy"]:</h2>
        <ul>
            <li><span style="font-family: 'Caveat', cursive; font-size: 1.5em;">OpenHabitTracker</span> @Loc["saves your data (notes, tasks and habits) on your device, offering you complete privacy."]</li>
            <li>@Loc["It allows you to delete the data stored on your device at any time."]</li>
            <li>@Loc["If you use the Docker image to enable online sync, all data is stored in your Docker container and is completely under your control."]</li>
            <li>@Loc["You can read the privacy policy at"] <a href="https://openhabittracker.net/privacy-policy.html" target="_blank">https://openhabittracker.net/privacy-policy.html</a></li>
        </ul>

        <span>© 2026 Jinjinov</span>

    </div>
</div>

@code {
    private ElementReference WrapperElement;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LinkAttributeService.AddAttributesToLinks(WrapperElement);
        }
    }
}
