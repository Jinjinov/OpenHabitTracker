@using GTour.Abstractions
@using OpenHabitTracker.App
@using OpenHabitTracker.Data
@using OpenHabitTracker.Data.Models
@using OpenHabitTracker.Services

@inject ClientState ClientState
@inject IJsInterop JsInterop
@inject IStringLocalizer Loc
@inject IGTourService GTourService
@inject IPriorityService PriorityService
@inject INotifications Notifications
@inject INotificationScheduler NotificationScheduler

<div>
    <div class="my-1 list-group">

        <div class="list-group-item" data-settings-step-1>
            <InputCheckbox id="IsDarkMode" class="form-check-input me-1" Value="_settings.IsDarkMode" ValueExpression="() => _settings.IsDarkMode" ValueChanged="SaveIsDarkMode" />
            <label for="IsDarkMode" class="form-check-label stretched-link">@Loc["Dark mode"]</label>
        </div>

        <div class="list-group-item" data-settings-step-2>
            <small>@Loc["Theme"]:</small>
            <InputSelect class="form-select" aria-label="@Loc["Theme"]" Value="_settings.Theme" ValueExpression="() => _settings.Theme" TValue="string" ValueChanged="SaveTheme">
                <option value="default">default</option>
                <option value="cerulean">cerulean</option>
                <option value="cosmo">cosmo</option>
                <option value="cyborg">cyborg</option>
                <option value="darkly">darkly</option>
                <option value="flatly">flatly</option>
                <option value="journal">journal</option>
                <option value="litera">litera</option>
                <option value="lumen">lumen</option>
                <option value="lux">lux</option>
                <option value="materia">materia</option>
                <option value="minty">minty</option>
                <option value="morph">morph</option>
                <option value="pulse">pulse</option>
                <option value="quartz">quartz</option>
                <option value="sandstone">sandstone</option>
                <option value="simplex">simplex</option>
                <option value="sketchy">sketchy</option>
                <option value="slate">slate</option>
                <option value="solar">solar</option>
                <option value="spacelab">spacelab</option>
                <option value="superhero">superhero</option>
                <option value="united">united</option>
                <option value="vapor">vapor</option>
                <option value="yeti">yeti</option>
                <option value="zephyr">zephyr</option>
            </InputSelect>
        </div>

        <div class="list-group-item" data-settings-step-3>
            <small>@Loc["Start page"]:</small>
            <InputSelect class="form-select" aria-label="@Loc["Start page"]" Value="_settings.StartPage" ValueExpression="() => _settings.StartPage" TValue="string" ValueChanged="SaveStartPage">
                @if (WindowDimensions?.Width >= 1280 || WindowDimensions?.Width < 768)
                {
                    <option value="">@Loc["Home"]</option>
                }
                <option value="/notes">@Loc["Notes"]</option>
                <option value="/tasks">@Loc["Tasks"]</option>
                <option value="/habits">@Loc["Habits"]</option>
            </InputSelect>
        </div>

        <div class="list-group-item" data-settings-step-4>
            <small>@Loc["Start sidebar"]:</small>
            <InputSelect class="form-select" aria-label="@Loc["Start sidebar"]" Value="_settings.StartSidebar" ValueExpression="() => _settings.StartSidebar" TValue="string" ValueChanged="SaveStartSidebar">
                <option value="">@Loc["None"]</option>
                <option value="Menu">@Loc["Menu"]</option>
                <option value="Trash">@Loc["Trash"]</option>
                <option value="Search">@Loc["Search, Filter, Sort"]</option>
                <option value="Settings">@Loc["Settings"]</option>
                <option value="Categories">@Loc["Categories"]</option>
                <option value="Data">@Loc["Data"]</option>
                <option value="About">@Loc["About"]</option>
            </InputSelect>
        </div>

        <div class="list-group-item" data-settings-step-5>
            <InputCheckbox id="ShowGroupedByCategory" class="form-check-input me-1" Value="_settings.ShowGroupedByCategory" ValueExpression="() => _settings.ShowGroupedByCategory" ValueChanged="SaveShowGroupedByCategory" />
            <label for="ShowGroupedByCategory" class="form-check-label stretched-link d-inline">@Loc["Group by category"]</label>
        </div>

        <div class="list-group-item" data-settings-step-6>
            <InputCheckbox id="ShowLastTimeDone" class="form-check-input me-1" Value="_settings.ShowLastTimeDone" ValueExpression="() => _settings.ShowLastTimeDone" ValueChanged="SaveShowLastTimeDone" />
            <label for="ShowLastTimeDone" class="form-check-label stretched-link d-inline">@Loc["Show last done time"]</label>
        </div>

        <div class="list-group-item" data-settings-step-7>
            <InputCheckbox id="ShowHelp" class="form-check-input me-1" Value="_settings.ShowHelp" ValueExpression="() => _settings.ShowHelp" ValueChanged="SaveShowHelp" />
            <label for="ShowHelp" class="form-check-label stretched-link d-inline">@Loc["Show help"]</label>
        </div>

        <div class="list-group-item" data-settings-step-8>
            <InputCheckbox id="ShowPriorityDropdown" class="form-check-input me-1" Value="_settings.ShowPriorityDropdown" ValueExpression="() => _settings.ShowPriorityDropdown" ValueChanged="SaveShowPriorityDropdown" />
            <label for="ShowPriorityDropdown" class="form-check-label stretched-link d-inline">@Loc["Show priority"]</label>
        </div>

        <div class="list-group-item" data-settings-step-9>
            <InputCheckbox id="ShowItemList" class="form-check-input me-1" Value="_settings.ShowItemList" ValueExpression="() => _settings.ShowItemList" ValueChanged="SaveShowItemList" />
            <label for="ShowItemList" class="form-check-label stretched-link d-inline">@Loc["Show item list"]</label>
        </div>

        <div class="list-group-item" data-settings-step-10>
            <InputCheckbox id="ShowSmallCalendar" class="form-check-input me-1" Value="_settings.ShowSmallCalendar" ValueExpression="() => _settings.ShowSmallCalendar" ValueChanged="SaveShowSmallCalendar" />
            <label for="ShowSmallCalendar" class="form-check-label stretched-link d-inline">@Loc["Show small calendar"]</label>
        </div>

        <div class="list-group-item" data-settings-step-11>
            <small>@Loc["Max days in small calendar"]:</small>
            <InputSelect class="form-select" aria-label="@Loc["Max days in small calendar"]" Value="_settings.MaxSmallCalendarDays" ValueExpression="() => _settings.MaxSmallCalendarDays" TValue="int" ValueChanged="SaveMaxSmallCalendarDays">
                <option value="0">@Loc["Auto"]</option>
                @for (int i = 1; i <= 31; i++)
                {
                    <option value="@i">@i</option>
                }
            </InputSelect>
        </div>

        <div class="list-group-item" data-settings-step-12>
            <InputCheckbox id="ShowLargeCalendar" class="form-check-input me-1" Value="_settings.ShowLargeCalendar" ValueExpression="() => _settings.ShowLargeCalendar" ValueChanged="SaveShowLargeCalendar" />
            <label for="ShowLargeCalendar" class="form-check-label stretched-link d-inline">@Loc["Show large calendar"]</label>
        </div>

        <div class="list-group-item" data-settings-step-13>
            <InputCheckbox id="ShowHabitStatistics" class="form-check-input me-1" Value="_settings.ShowHabitStatistics" ValueExpression="() => _settings.ShowHabitStatistics" ValueChanged="SaveShowHabitStatistics" />
            <label for="ShowHabitStatistics" class="form-check-label stretched-link d-inline">@Loc["Show habit statistics"]</label>
        </div>

        <div class="list-group-item" data-settings-step-14>
            <InputCheckbox id="ShowHabitCharts" class="form-check-input me-1" Value="_settings.ShowHabitCharts" ValueExpression="() => _settings.ShowHabitCharts" ValueChanged="SaveShowHabitCharts" />
            <label for="ShowHabitCharts" class="form-check-label stretched-link d-inline">@Loc["Show habit charts"]</label>
        </div>

        <div class="list-group-item" data-settings-step-15>
            <InputCheckbox id="ShowCategory" class="form-check-input me-1" Value="_settings.ShowCategory" ValueExpression="() => _settings.ShowCategory" ValueChanged="SaveShowCategory" />
            <label for="ShowCategory" class="form-check-label stretched-link d-inline">@Loc["Show category"]</label>
        </div>

        <div class="list-group-item" data-settings-step-16>
            <InputCheckbox id="ShowColor" class="form-check-input me-1" Value="_settings.ShowColor" ValueExpression="() => _settings.ShowColor" ValueChanged="SaveShowColor" />
            <label for="ShowColor" class="form-check-label stretched-link d-inline">@Loc["Show color"]</label>
        </div>

        <div class="list-group-item" data-settings-step-17>
            <InputCheckbox id="ShowCreatedUpdated" class="form-check-input me-1" Value="_settings.ShowCreatedUpdated" ValueExpression="() => _settings.ShowCreatedUpdated" ValueChanged="SaveShowCreatedUpdated" />
            <label for="ShowCreatedUpdated" class="form-check-label stretched-link d-inline">@Loc["Show created & updated"]</label>
        </div>

        <div class="list-group-item" data-settings-step-18>
            <small>@Loc["Language"]:</small>
            <InputSelect class="form-select" aria-label="@Loc["Language"]" Value="_settings.Culture" ValueExpression="() => _settings.Culture" TValue="string" ValueChanged="SaveCulture">
                @foreach ((string key, Localization.Loc loc) in Localization.Loc.Cultures)
                {
                    <option value="@key">@loc.Language</option>
                }
            </InputSelect>
        </div>

        <div class="list-group-item" data-settings-step-19>
            <small>@Loc["Week start"]:</small>
            <InputSelect class="form-select" aria-label="@Loc["Week start"]" Value="_settings.FirstDayOfWeek" ValueExpression="() => _settings.FirstDayOfWeek" TValue="DayOfWeek" ValueChanged="SaveFirstDayOfWeek">
                @foreach (DayOfWeek dayOfWeek in Enum.GetValues<DayOfWeek>())
                {
                    <option value="@dayOfWeek">@Loc[dayOfWeek.ToString()]</option>
                }
            </InputSelect>
        </div>

        <div class="list-group-item" data-settings-step-20>
            <InputCheckbox id="InsertTabsInNoteContent" class="form-check-input me-1" Value="_settings.InsertTabsInNoteContent" ValueExpression="() => _settings.InsertTabsInNoteContent" ValueChanged="SaveInsertTabsInNoteContent" />
            <label for="InsertTabsInNoteContent" class="form-check-label stretched-link d-inline">@Loc["Insert tabs in note content"]</label>
        </div>

        <div class="list-group-item" data-settings-step-21>
            <InputCheckbox id="DisplayNoteContentAsMarkdown" class="form-check-input me-1" Value="_settings.DisplayNoteContentAsMarkdown" ValueExpression="() => _settings.DisplayNoteContentAsMarkdown" ValueChanged="SaveDisplayNoteContentAsMarkdown" />
            <label for="DisplayNoteContentAsMarkdown" class="form-check-label stretched-link d-inline">@Loc["Display note content as Markdown"]</label>
        </div>

        <div class="list-group-item" data-settings-step-22>
            <InputCheckbox id="UncheckAllItemsOnHabitDone" class="form-check-input me-1" Value="_settings.UncheckAllItemsOnHabitDone" ValueExpression="() => _settings.UncheckAllItemsOnHabitDone" ValueChanged="SaveUncheckAllItemsOnHabitDone" />
            <label for="UncheckAllItemsOnHabitDone" class="form-check-label stretched-link d-inline">@Loc["Reset habit when it is completed"]</label>
        </div>

        <div class="list-group-item" data-settings-step-23>
            <small>@Loc["Display category filter as"]:</small>
            <InputSelect class="form-select" aria-label="@Loc["Display category filter as"]" Value="_settings.CategoryFilterDisplay" ValueExpression="() => _settings.CategoryFilterDisplay" TValue="FilterDisplay" ValueChanged="SaveCategoryFilterDisplay">
                <option value="@FilterDisplay.CheckBoxes">@Loc["Check boxes"]</option>
                <option value="@FilterDisplay.RadioButtons">@Loc["Radio buttons"]</option>
                <option value="@FilterDisplay.SelectOptions">@Loc["Drop down list"]</option>
            </InputSelect>
        </div>

        <div class="list-group-item" data-settings-step-24>
            <small>@Loc["Display priority filter as"]:</small>
            <InputSelect class="form-select" aria-label="@Loc["Display priority filter as"]" Value="_settings.PriorityFilterDisplay" ValueExpression="() => _settings.PriorityFilterDisplay" TValue="FilterDisplay" ValueChanged="SavePriorityFilterDisplay">
                <option value="@FilterDisplay.CheckBoxes">@Loc["Check boxes"]</option>
                <option value="@FilterDisplay.RadioButtons">@Loc["Radio buttons"]</option>
                <option value="@FilterDisplay.SelectOptions">@Loc["Drop down list"]</option>
            </InputSelect>
        </div>

        <div class="list-group-item" data-settings-step-25>
            <small>@Loc["Horizontal space"]:</small>
            <InputSelect class="form-select" aria-label="@Loc["Horizontal space"]" Value="_settings.HorizontalMargin" ValueExpression="() => _settings.HorizontalMargin" TValue="int" ValueChanged="SaveHorizontalMargin">
                @for (int i = 0; i <= 5; i++)
                {
                    <option value="@i">@i</option>
                }
            </InputSelect>
        </div>

        <div class="list-group-item" data-settings-step-26>
            <small>@Loc["Vertical space"]:</small>
            <InputSelect class="form-select" aria-label="@Loc["Vertical space"]" Value="_settings.VerticalMargin" ValueExpression="() => _settings.VerticalMargin" TValue="int" ValueChanged="SaveVerticalMargin">
                @for (int i = 0; i <= 5; i++)
                {
                    <option value="@i">@i</option>
                }
            </InputSelect>
        </div>

        @if (Notifications.CanNotify)
        {
            <div class="list-group-item">
                <small>@Loc["Daily summary at"]:</small>
                <div class="input-group" data-settings-step-27>
                    <InputDate class="form-control" Type="InputDateType.Time" aria-label="@Loc["Daily summary at"]" Value="_settings.NotificationTime" ValueExpression="() => _settings.NotificationTime" TValue="TimeOnly?" ValueChanged="SaveNotificationTime" />
                    <button class="btn btn-outline-primary" aria-label="@Loc["Clear daily summary time"]" @onclick="() => SaveNotificationTime(null)"><i class="bi bi-x-square"></i></button>
                </div>

                <small class="d-block mt-2">@Loc["Daily summary covers"]:</small>
                <div data-settings-step-28>
                    <InputSelect class="form-select" aria-label="@Loc["Daily summary covers"]" Value="_settings.NotificationContent" ValueExpression="() => _settings.NotificationContent" TValue="DigestContent" ValueChanged="SaveNotificationContent">
                        <option value="@DigestContent.Both">@Loc["Tasks and habits"]</option>
                        <option value="@DigestContent.Tasks">@Loc["Tasks"]</option>
                        <option value="@DigestContent.Habits">@Loc["Habits"]</option>
                    </InputSelect>
                </div>

                <div class="mt-2" data-settings-step-29>
                    <small>@Loc["Notify about habits over"] @_settings.NotificationHabitThreshold%</small>
                    <input type="range" min="0" max="200" class="form-range d-block" aria-label="@Loc["Notify about habits over"]" value="@_settings.NotificationHabitThreshold" @oninput="(ChangeEventArgs args) => SaveNotificationHabitThreshold(Convert.ToInt32(args.Value))" />
                </div>

                <div class="position-relative mt-2" data-settings-step-30>
                    <InputCheckbox id="NotificationIncludeOverdueTasks" class="form-check-input me-1" Value="_settings.NotificationIncludeOverdueTasks" ValueExpression="() => _settings.NotificationIncludeOverdueTasks" ValueChanged="SaveNotificationIncludeOverdueTasks" />
                    <label for="NotificationIncludeOverdueTasks" class="form-check-label stretched-link d-inline">@Loc["Include overdue tasks"]</label>
                </div>
            </div>

            <div class="list-group-item" data-settings-step-31>
                <div class="position-relative">
                    <InputCheckbox id="NotificationLead" class="form-check-input me-1" Value="_settings.NotificationLeadMinutes is not null" ValueExpression="() => _notificationLeadOn" ValueChanged="SaveNotificationLeadOn" />
                    <label for="NotificationLead" class="form-check-label stretched-link d-inline">@Loc["Remind before a planned task"]</label>
                </div>

                <div class="input-group mt-2">
                    <InputSelect class="form-select" aria-label="@Loc["Remind hours"]" Value="_settings.NotificationLeadHour" ValueExpression="() => _settings.NotificationLeadHour" TValue="int" ValueChanged="(int hour) => SaveNotificationLead(hour, _settings.NotificationLeadMinute)">
                        @for (int i = 0; i <= 24; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </InputSelect>
                    <span class="input-group-text bg-transparent">h</span>

                    <InputSelect class="form-select" aria-label="@Loc["Remind minutes"]" Value="_settings.NotificationLeadMinute" ValueExpression="() => _settings.NotificationLeadMinute" TValue="int" ValueChanged="(int minute) => SaveNotificationLead(_settings.NotificationLeadHour, minute)">
                        @for (int i = 0; i <= 59; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </InputSelect>
                    <span class="input-group-text bg-transparent">min</span>

                    <button class="btn btn-outline-primary" aria-label="@Loc["Clear reminder time"]" @onclick="() => SaveNotificationLead(0, 0)"><i class="bi bi-x-square"></i></button>
                </div>
            </div>

            <div class="list-group-item" data-settings-step-32>
                <small>@Loc["Notify only from priority"]:</small>
                <InputSelect class="form-select" aria-label="@Loc["Notify only from priority"]" Value="_settings.NotificationMinimumPriority" ValueExpression="() => _settings.NotificationMinimumPriority" TValue="Priority" ValueChanged="SaveNotificationMinimumPriority">
                    <option value="@Priority.None">@Loc["Any priority"]</option>
                    @foreach (Priority priority in Enum.GetValues<Priority>())
                    {
                        @if (priority != Priority.None)
                        {
                            <option value="@priority">@Loc[PriorityService.GetPriorityName(priority)]</option>
                        }
                    }
                </InputSelect>
            </div>
        }

    </div>
</div>

@if (ClientState.Settings.ShowHelp)
{
    <GuidedTourComponent TourId="settings" TourSteps="tourSteps" />
}

@code {
    TourStep[] tourSteps;

    public Settings()
    {
        tourSteps = new TourStep[]
        {
            new() { Text = "Toggle dark mode." },
            new() { Text = "Choose a theme." },
            new() { Text = "Choose a start page that should open every time you start OpenHabitTracker." },
            new() { Text = "Choose a start sidebar that should open every time you start OpenHabitTracker." },
            new() { Text = "Group items by category in Notes, Tasks and Habits." },
            new() { Text = "Show the time each habit was last completed in the category header." },
            new() { Text = "Show help on every page." },
            new() { Text = "Show the priority in Notes, Tasks and Habits." },
            new() { Text = "Show the item list in Tasks and Habits." },
            new() { Text = "Show the small calendar in one line in Habits." },
            new() { Text = "Choose the maximum number of days shown in the small calendar in Habits. Auto shows as many days as fit." },
            new() { Text = "Show the large calendar for the selected Habit." },
            new() { Text = "Show the habit statistics." },
            new() { Text = "Show the habit charts: target, history, calendar, best streaks and frequency." },
            new() { Text = "Show the category in Notes, Tasks and Habits." },
            new() { Text = "Show the color picker in Notes, Tasks and Habits." },
            new() { Text = "Show the created date and the updated date in Notes, Tasks and Habits." },
            new() { Text = "Choose a language." },
            new() { Text = "Choose the start of the week in the large calendar in Habits." },
            new() { Text = "Pressing the TAB key inserts a tab in the content when writing the text in Notes." },
            new() { Text = "You can use Markdown to format the content in Notes." },
            new() { Text = "Resetting the habit when it is completed will uncheck all items." },
            new() { Text = "Choose how to display the category filter." },
            new() { Text = "Choose how to display the priority filter." },
            new() { Text = "Choose the horizontal space between items in the list." },
            new() { Text = "Choose the vertical space between items in the list." },
            new() { Text = "Choose the time of day the daily summary of what is due arrives, or clear it to turn it off.", Show = () => Notifications.CanNotify },
            new() { Text = "Choose whether the daily summary covers tasks, habits, or both.", Show = () => Notifications.CanNotify },
            new() { Text = "Choose how far over its interval a habit has to be before the daily summary mentions it.", Show = () => Notifications.CanNotify },
            new() { Text = "Let the daily summary count tasks that are past their planned time and still not done.", Show = () => Notifications.CanNotify },
            new() { Text = "Choose how long before a task\'s planned time its reminder arrives, or turn it off.", Show = () => Notifications.CanNotify },
            new() { Text = "Only notify about items at this priority or higher.", Show = () => Notifications.CanNotify },
    };
    }

    private async Task StartTour(string tourId)
    {
        await InvokeAsync(() => GTourService.StartTour(tourId));
    }

    [Parameter]
    public Ref<bool> StateChanged { get; set; } = new();

    [Parameter]
    public EventCallback<bool> StateChangedChanged { get; set; }

    [Parameter]
    public Dimensions? WindowDimensions { get; set; }

    SettingsModel _settings => ClientState.Settings;


    async Task UpdateAndRefresh()
    {
        await ClientState.UpdateSettings();

        await NotificationScheduler.Rebuild();

        StateChanged.Value = !StateChanged.Value;
        await StateChangedChanged.InvokeAsync(StateChanged.Value);
    }

    async Task SaveIsDarkMode(bool isDarkMode)
    {
        if (_settings.IsDarkMode != isDarkMode)
        {
            string mode = isDarkMode ? "dark" : "light";
            await JsInterop.SetMode(mode);
        }

        _settings.IsDarkMode = isDarkMode;

        await ClientState.UpdateSettings();
    }

    async Task SaveTheme(string theme)
    {
        if (_settings.Theme != theme)
        {
            await JsInterop.SetTheme(theme);
        }

        _settings.Theme = theme;

        await ClientState.UpdateSettings();
    }

    async Task SaveStartPage(string startPage)
    {
        _settings.StartPage = startPage;

        await ClientState.UpdateSettings();
    }

    async Task SaveStartSidebar(string startSidebar)
    {
        _settings.StartSidebar = startSidebar;

        await ClientState.UpdateSettings();
    }

    async Task SaveShowGroupedByCategory(bool show)
    {
        _settings.ShowGroupedByCategory = show;

        await UpdateAndRefresh();
    }

    async Task SaveShowLastTimeDone(bool show)
    {
        _settings.ShowLastTimeDone = show;

        await UpdateAndRefresh();
    }

    async Task SaveShowHelp(bool show)
    {
        _settings.ShowHelp = show;

        await UpdateAndRefresh();
    }

    async Task SaveShowPriorityDropdown(bool show)
    {
        _settings.ShowPriorityDropdown = show;

        await UpdateAndRefresh();
    }

    async Task SaveShowItemList(bool show)
    {
        _settings.ShowItemList = show;

        await UpdateAndRefresh();
    }

    async Task SaveShowSmallCalendar(bool show)
    {
        _settings.ShowSmallCalendar = show;

        await UpdateAndRefresh();
    }

    async Task SaveMaxSmallCalendarDays(int maxDays)
    {
        _settings.MaxSmallCalendarDays = maxDays;

        await UpdateAndRefresh();
    }

    async Task SaveShowLargeCalendar(bool show)
    {
        _settings.ShowLargeCalendar = show;

        await UpdateAndRefresh();
    }

    async Task SaveShowHabitCharts(bool show)
    {
        _settings.ShowHabitCharts = show;

        await UpdateAndRefresh();
    }

    async Task SaveShowHabitStatistics(bool show)
    {
        _settings.ShowHabitStatistics = show;

        await UpdateAndRefresh();
    }

    async Task SaveShowCategory(bool show)
    {
        _settings.ShowCategory = show;

        await UpdateAndRefresh();
    }

    async Task SaveShowColor(bool show)
    {
        _settings.ShowColor = show;

        await UpdateAndRefresh();
    }

    async Task SaveShowCreatedUpdated(bool show)
    {
        _settings.ShowCreatedUpdated = show;

        await UpdateAndRefresh();
    }

    async Task SaveCulture(string culture)
    {
        _settings.Culture = culture;

        Localization.Loc.SetCulture(culture);

        await JsInterop.SetLang(culture);

        await UpdateAndRefresh();
    }

    async Task SaveFirstDayOfWeek(DayOfWeek dayOfWeek)
    {
        _settings.FirstDayOfWeek = dayOfWeek;

        await UpdateAndRefresh();
    }

    async Task SaveInsertTabsInNoteContent(bool val)
    {
        _settings.InsertTabsInNoteContent = val;

        await UpdateAndRefresh();
    }

    async Task SaveDisplayNoteContentAsMarkdown(bool val)
    {
        _settings.DisplayNoteContentAsMarkdown = val;

        await UpdateAndRefresh();
    }

    async Task SaveUncheckAllItemsOnHabitDone(bool val)
    {
        _settings.UncheckAllItemsOnHabitDone = val;

        await UpdateAndRefresh();
    }

    async Task SaveCategoryFilterDisplay(FilterDisplay filterDisplay)
    {
        _settings.CategoryFilterDisplay = filterDisplay;

        await UpdateAndRefresh();
    }

    async Task SavePriorityFilterDisplay(FilterDisplay filterDisplay)
    {
        _settings.PriorityFilterDisplay = filterDisplay;

        await UpdateAndRefresh();
    }

    async Task SaveHorizontalMargin(int horizontalMargin)
    {
        _settings.HorizontalMargin = horizontalMargin;

        await UpdateAndRefresh();
    }

    async Task SaveVerticalMargin(int verticalMargin)
    {
        _settings.VerticalMargin = verticalMargin;

        await UpdateAndRefresh();
    }

    async Task SaveNotificationTime(TimeOnly? time)
    {
        _settings.NotificationTime = await Allowed(time is not null) ? time : null;

        await UpdateAndRefresh();
    }

    // The checkbox owns on and off; the two selects own the value, and setting one turns it on.
    bool _notificationLeadOn => _settings.NotificationLeadMinutes is not null;

    async Task SaveNotificationLeadOn(bool on)
    {
        _settings.NotificationLeadMinutes = await Allowed(on) ? _settings.NotificationLeadMinutes ?? 0 : null;

        await UpdateAndRefresh();
    }

    async Task SaveNotificationLead(int hour, int minute)
    {
        _settings.NotificationLeadMinutes = await Allowed(true) ? hour * 60 + minute : null;

        await UpdateAndRefresh();
    }

    // Turning a half on needs the OS permission; a refusal is permanent on iOS,
    // so the setting goes back to off rather than staying on while nothing fires.
    async Task<bool> Allowed(bool turningOn)
    {
        return turningOn && await Notifications.RequestPermission();
    }

    async Task SaveNotificationContent(DigestContent content)
    {
        _settings.NotificationContent = content;

        await UpdateAndRefresh();
    }

    async Task SaveNotificationMinimumPriority(Priority priority)
    {
        _settings.NotificationMinimumPriority = priority;

        await UpdateAndRefresh();
    }

    async Task SaveNotificationHabitThreshold(int threshold)
    {
        _settings.NotificationHabitThreshold = threshold;

        await UpdateAndRefresh();
    }

    async Task SaveNotificationIncludeOverdueTasks(bool include)
    {
        _settings.NotificationIncludeOverdueTasks = include;

        await UpdateAndRefresh();
    }
}
