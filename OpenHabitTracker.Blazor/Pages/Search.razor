@using GTour.Abstractions
@using OpenHabitTracker.App
@using OpenHabitTracker.Data
@using OpenHabitTracker.Data.Models
@using OpenHabitTracker.Services

@inject ClientState ClientState
@inject ICategoryService CategoryService
@inject ISearchFilterService SearchFilterService
@inject IStringLocalizer Loc
@inject IGTourService GTourService

<div>
    @if (CategoryService.Categories is not null)
    {
        <div class="my-1 list-group">

            <button class="btn btn-plain border-0 p-0 text-start mx-1 my-2" @onclick="() => ToggleFoldSection(QuerySection.Search)" aria-expanded="@(!_settings.FoldSection[QuerySection.Search])">
                <small><i class="bi bi-search" aria-hidden="true"></i> @Loc["Search"]<i class="@($"bi {GetFoldIcon(QuerySection.Search)} mx-1")" aria-hidden="true"></i></small>
            </button>

            @if (!_settings.FoldSection[QuerySection.Search])
            {
            <div class="input-group flex-nowrap">
                <InputTextImmediate class="form-control" Value="@SearchFilterService.SearchTerm" ValueExpression="() => SearchFilterService.SearchTerm" ValueChanged="UpdateSearchTerm" placeholder="@Loc["Search..."]" aria-label="@Loc["Search"]" @attributes="dataSearchStep1" />
                @if (SearchFilterService.MatchCase)
                {
                    <button class="btn btn-primary" aria-label="@Loc["Match case"]" @onclick="() => UpdateMatchCase(false)" data-search-step-2><i class="bi bi-type"></i></button>
                }
                else
                {
                    <button class="btn btn-outline-primary" aria-label="@Loc["Match case"]" @onclick="() => UpdateMatchCase(true)" data-search-step-2><i class="bi bi-type"></i></button>
                }
                <button class="btn btn-outline-primary" aria-label="@Loc["Clear search"]" @onclick="() => UpdateSearchTerm(null)" data-search-step-3><i class="bi bi-x-square"></i></button>
            </div>
            }

            <button class="btn btn-plain border-0 p-0 text-start mx-1 my-2" @onclick="() => ToggleFoldSection(QuerySection.FilterByDate)" aria-expanded="@(!_settings.FoldSection[QuerySection.FilterByDate])">
                <small><i class="bi bi-filter" aria-hidden="true"></i> @Loc["Filter by date"]<i class="@($"bi {GetFoldIcon(QuerySection.FilterByDate)} mx-1")" aria-hidden="true"></i></small>
            </button>

            @if (!_settings.FoldSection[QuerySection.FilterByDate])
            {
            <div class="input-group flex-nowrap">
                <button class="input-group-text col-4" @onclick="() => UpdatePlannedAtFilter(DateTime.Today)" data-search-step-4>@Loc["Planned"]</button>
                <div data-search-step-5>
                <InputSelect class="form-control w-auto flex-grow-0" aria-label="@Loc["Planned date comparison"]" Value="SearchFilterService.PlannedAtCompare" ValueExpression="() => SearchFilterService.PlannedAtCompare" TValue="DateCompare" ValueChanged="UpdatePlannedAtCompare">
                    <option value="@DateCompare.Before">@("<")</option>
                    <option value="@DateCompare.On">@("=")</option>
                    <option value="@DateCompare.After">@(">")</option>
                    <option value="@DateCompare.NotOn">@("≠")</option>
                </InputSelect>
                </div>
                <InputDate class="form-control" aria-label="@Loc["Planned"]" Value="SearchFilterService.PlannedAtFilter" ValueExpression="() => SearchFilterService.PlannedAtFilter" TValue="DateTime?" ValueChanged="UpdatePlannedAtFilter" Type="InputDateType.Date" @attributes="dataSearchStep6" />
                <button class="btn btn-outline-primary" aria-label="@Loc["Clear planned date"]" @onclick="() => UpdatePlannedAtFilter(null)" data-search-step-7><i class="bi bi-x-square"></i></button>
            </div>

            <div class="input-group flex-nowrap">
                <button class="input-group-text col-4" @onclick="() => UpdateDoneAtFilter(DateTime.Today)" data-search-step-8>@Loc["Done"]</button>
                <div data-search-step-9>
                <InputSelect class="form-control w-auto flex-grow-0" aria-label="@Loc["Done date comparison"]" Value="SearchFilterService.DoneAtCompare" ValueExpression="() => SearchFilterService.DoneAtCompare" TValue="DateCompare" ValueChanged="UpdateDoneAtCompare">
                    <option value="@DateCompare.Before">@("<")</option>
                    <option value="@DateCompare.On">@("=")</option>
                    <option value="@DateCompare.After">@(">")</option>
                    <option value="@DateCompare.NotOn">@("≠")</option>
                </InputSelect>
                </div>
                <InputDate class="form-control" aria-label="@Loc["Done"]" Value="SearchFilterService.DoneAtFilter" ValueExpression="() => SearchFilterService.DoneAtFilter" TValue="DateTime?" ValueChanged="UpdateDoneAtFilter" Type="InputDateType.Date" @attributes="dataSearchStep10" />
                <button class="btn btn-outline-primary" aria-label="@Loc["Clear done date"]" @onclick="() => UpdateDoneAtFilter(null)" data-search-step-11><i class="bi bi-x-square"></i></button>
            </div>

            <div class="list-group-item" data-search-step-12>
                <small>@Loc["Planned within days from today"]:</small>
                <div class="input-group flex-nowrap mt-2">
                    <InputNumber class="form-control" aria-label="@Loc["Earliest planned day offset from today"]" placeholder="-" Value="_settings.PlannedFromDayOffset" ValueExpression="() => _settings.PlannedFromDayOffset" ValueChanged="SavePlannedFromDayOffset" TValue="int?" />
                    <span class="input-group-text bg-transparent">@Loc["to"]</span>
                    <InputNumber class="form-control" aria-label="@Loc["Latest planned day offset from today"]" placeholder="+" Value="_settings.PlannedToDayOffset" ValueExpression="() => _settings.PlannedToDayOffset" ValueChanged="SavePlannedToDayOffset" TValue="int?" />
                </div>
                @if (_settings.PlannedFromDayOffset is not null || _settings.PlannedToDayOffset is not null)
                {
                    <div class="input-group flex-nowrap mt-2">
                        <span class="input-group-text bg-transparent flex-grow-1">@RelativeRangePreview(_settings.ResolvePlannedRange(DateTime.Today))</span>
                        <button class="btn btn-outline-primary" aria-label="@Loc["Clear planned range"]" @onclick="ClearPlannedRange"><i class="bi bi-x-square"></i></button>
                    </div>
                }
            </div>

            <div class="list-group-item" data-search-step-13>
                <div class="d-flex align-items-center">
                    <small>@Loc[_settings.ShowDoneInRange ? "Done within days from today" : "Not done within days from today"]:</small>
                    <div class="form-check form-switch ms-auto mb-0">
                        <InputCheckbox class="form-check-input" role="switch" aria-label="@Loc["Done within days from today"]" Value="_settings.ShowDoneInRange" ValueExpression="() => _settings.ShowDoneInRange" ValueChanged="SaveShowDoneInRange" />
                    </div>
                </div>
                <div class="input-group flex-nowrap mt-2">
                    <InputNumber class="form-control" aria-label="@Loc["Earliest done day offset from today"]" placeholder="-" Value="_settings.DoneFromDayOffset" ValueExpression="() => _settings.DoneFromDayOffset" ValueChanged="SaveDoneFromDayOffset" TValue="int?" />
                    <span class="input-group-text bg-transparent">@Loc["to"]</span>
                    <InputNumber class="form-control" aria-label="@Loc["Latest done day offset from today"]" placeholder="+" Value="_settings.DoneToDayOffset" ValueExpression="() => _settings.DoneToDayOffset" ValueChanged="SaveDoneToDayOffset" TValue="int?" />
                </div>
                @if (_settings.DoneFromDayOffset is not null || _settings.DoneToDayOffset is not null)
                {
                    <div class="input-group flex-nowrap mt-2">
                        <span class="input-group-text bg-transparent flex-grow-1">@RelativeRangePreview(_settings.ResolveDoneRange(DateTime.Today))</span>
                        <button class="btn btn-outline-primary" aria-label="@Loc["Clear done range"]" @onclick="ClearDoneRange"><i class="bi bi-x-square"></i></button>
                    </div>
                }
            </div>
            }

            <button class="btn btn-plain border-0 p-0 text-start mx-1 my-2" @onclick="() => ToggleFoldSection(QuerySection.FilterByCategory)" aria-expanded="@(!_settings.FoldSection[QuerySection.FilterByCategory])">
                <small><i class="bi bi-filter" aria-hidden="true"></i> @Loc["Filter by category"]<i class="@($"bi {GetFoldIcon(QuerySection.FilterByCategory)} mx-1")" aria-hidden="true"></i></small>
            </button>

            @if (!_settings.FoldSection[QuerySection.FilterByCategory])
            {
                @if (_settings.CategoryFilterDisplay == FilterDisplay.CheckBoxes)
                {
                    <div class="list-group-item" data-search-step-14>
                        <CheckBox IsTriState="true" Checked="ShowAllCategories" CheckedChanged="(bool? show) => SetShowAllCategories()">
                            <span>@Loc["Categories"]:</span>
                        </CheckBox>

                        <div class="mt-3" />

                        @foreach (CategoryModel category in CategoryService.Categories)
                        {
                            bool isSelected = !_settings.HiddenCategoryIds.Contains(category.Id);

                            <div class="form-check position-relative">
                                <InputCheckbox id="@($"category-{category.Id}")" class="form-check-input me-1" Value="isSelected" ValueExpression="() => isSelected" ValueChanged="(bool show) => SaveCategoryIds(category.Id, show)" />
                                <label for="@($"category-{category.Id}")" class="form-check-label stretched-link d-inline">@category.Title</label>
                            </div>
                        }
                    </div>
                }
                else if (_settings.CategoryFilterDisplay == FilterDisplay.RadioButtons)
                {
                    <div class="list-group-item" data-search-step-14>
                        <span>@Loc["Categories"]:</span>
                        <div class="mt-3" />
                        <div class="form-check position-relative">
                            <input type="radio" id="category-all" class="form-check-input me-1" checked="@(_settings.SelectedCategoryId == null)" @onchange="@(() => SaveSelectedCategoryId(null))" />
                            <label for="category-all" class="form-check-label stretched-link d-inline">@Loc["All"]</label>
                        </div>
                        @foreach (CategoryModel category in CategoryService.Categories)
                        {
                            <div class="form-check position-relative">
                                <input type="radio" id="@($"category-{category.Id}")" class="form-check-input me-1" checked="@(_settings.SelectedCategoryId == category.Id)" @onchange="@(() => SaveSelectedCategoryId(category.Id))" />
                                <label for="@($"category-{category.Id}")" class="form-check-label stretched-link d-inline">@category.Title</label>
                            </div>
                        }
                    </div>
                }
                else if (_settings.CategoryFilterDisplay == FilterDisplay.SelectOptions)
                {
                    <div class="list-group-item" data-search-step-14>
                        <small>@Loc["Categories"]:</small>
                        <InputSelect class="form-select" aria-label="@Loc["Categories"]" Value="_settings.SelectedCategoryId" ValueExpression="() => _settings.SelectedCategoryId" TValue="long?" ValueChanged="SaveSelectedCategoryId">
                            <option value="">@Loc["All"]</option>
                            @foreach (CategoryModel category in CategoryService.Categories)
                            {
                                <option value="@category.Id">@category.Title</option>
                            }
                        </InputSelect>
                    </div>
                }
            }

            <button class="btn btn-plain border-0 p-0 text-start mx-1 my-2" @onclick="() => ToggleFoldSection(QuerySection.FilterByPriority)" aria-expanded="@(!_settings.FoldSection[QuerySection.FilterByPriority])">
                <small><i class="bi bi-filter" aria-hidden="true"></i> @Loc["Filter by priority"]<i class="@($"bi {GetFoldIcon(QuerySection.FilterByPriority)} mx-1")" aria-hidden="true"></i></small>
            </button>

            @if (!_settings.FoldSection[QuerySection.FilterByPriority])
            {
                @if (_settings.PriorityFilterDisplay == FilterDisplay.CheckBoxes)
                {
                    <div class="list-group-item" data-search-step-15>
                        <CheckBox IsTriState="true" Checked="ShowAllPriorities" CheckedChanged="(bool? show) => SetShowAllPriorities()">
                            <span>@Loc["Priorities"]:</span>
                        </CheckBox>

                        <div class="form-check position-relative mt-3">
                            <InputCheckbox id="Priority.None" class="form-check-input me-1" Value="_settings.ShowPriority[Priority.None]" ValueExpression="() => _settings.ShowPriority[Priority.None]" ValueChanged="(bool show) => SaveShowPriority(Priority.None, show)" />
                            <label for="Priority.None" class="form-check-label stretched-link d-inline">⊘ @Loc["None"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <InputCheckbox id="Priority.VeryLow" class="form-check-input me-1" Value="_settings.ShowPriority[Priority.VeryLow]" ValueExpression="() => _settings.ShowPriority[Priority.VeryLow]" ValueChanged="(bool show) => SaveShowPriority(Priority.VeryLow, show)" />
                            <label for="Priority.VeryLow" class="form-check-label stretched-link d-inline">︾ @Loc["Very low"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <InputCheckbox id="Priority.Low" class="form-check-input me-1" Value="_settings.ShowPriority[Priority.Low]" ValueExpression="() => _settings.ShowPriority[Priority.Low]" ValueChanged="(bool show) => SaveShowPriority(Priority.Low, show)" />
                            <label for="Priority.Low" class="form-check-label stretched-link d-inline">﹀ @Loc["Low"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <InputCheckbox id="Priority.Medium" class="form-check-input me-1" Value="_settings.ShowPriority[Priority.Medium]" ValueExpression="() => _settings.ShowPriority[Priority.Medium]" ValueChanged="(bool show) => SaveShowPriority(Priority.Medium, show)" />
                            <label for="Priority.Medium" class="form-check-label stretched-link d-inline">— @Loc["Medium"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <InputCheckbox id="Priority.High" class="form-check-input me-1" Value="_settings.ShowPriority[Priority.High]" ValueExpression="() => _settings.ShowPriority[Priority.High]" ValueChanged="(bool show) => SaveShowPriority(Priority.High, show)" />
                            <label for="Priority.High" class="form-check-label stretched-link d-inline">︿ @Loc["High"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <InputCheckbox id="Priority.VeryHigh" class="form-check-input me-1" Value="_settings.ShowPriority[Priority.VeryHigh]" ValueExpression="() => _settings.ShowPriority[Priority.VeryHigh]" ValueChanged="(bool show) => SaveShowPriority(Priority.VeryHigh, show)" />
                            <label for="Priority.VeryHigh" class="form-check-label stretched-link d-inline">︽ @Loc["Very high"]</label>
                        </div>
                    </div>
                }
                else if (_settings.PriorityFilterDisplay == FilterDisplay.RadioButtons)
                {
                    <div class="list-group-item" data-search-step-15>
                        <span>@Loc["Priorities"]:</span>

                        <div class="form-check position-relative mt-3">
                            <input type="radio" id="Priority.All" class="form-check-input me-1" checked="@(_settings.SelectedPriority == null)" @onchange="() => SaveSelectedPriority(null)" />
                            <label for="Priority.All" class="form-check-label stretched-link d-inline">@Loc["All"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <input type="radio" id="Priority.None" class="form-check-input me-1" checked="@(_settings.SelectedPriority == Priority.None)" @onchange="() => SaveSelectedPriority(Priority.None)" />
                            <label for="Priority.None" class="form-check-label stretched-link d-inline">⊘ @Loc["None"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <input type="radio" id="Priority.VeryLow" class="form-check-input me-1" checked="@(_settings.SelectedPriority == Priority.VeryLow)" @onchange="() => SaveSelectedPriority(Priority.VeryLow)" />
                            <label for="Priority.VeryLow" class="form-check-label stretched-link d-inline">︾ @Loc["Very low"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <input type="radio" id="Priority.Low" class="form-check-input me-1" checked="@(_settings.SelectedPriority == Priority.Low)" @onchange="() => SaveSelectedPriority(Priority.Low)" />
                            <label for="Priority.Low" class="form-check-label stretched-link d-inline">﹀ @Loc["Low"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <input type="radio" id="Priority.Medium" class="form-check-input me-1" checked="@(_settings.SelectedPriority == Priority.Medium)" @onchange="() => SaveSelectedPriority(Priority.Medium)" />
                            <label for="Priority.Medium" class="form-check-label stretched-link d-inline">— @Loc["Medium"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <input type="radio" id="Priority.High" class="form-check-input me-1" checked="@(_settings.SelectedPriority == Priority.High)" @onchange="() => SaveSelectedPriority(Priority.High)" />
                            <label for="Priority.High" class="form-check-label stretched-link d-inline">︿ @Loc["High"]</label>
                        </div>
                        <div class="form-check position-relative">
                            <input type="radio" id="Priority.VeryHigh" class="form-check-input me-1" checked="@(_settings.SelectedPriority == Priority.VeryHigh)" @onchange="() => SaveSelectedPriority(Priority.VeryHigh)" />
                            <label for="Priority.VeryHigh" class="form-check-label stretched-link d-inline">︽ @Loc["Very high"]</label>
                        </div>
                    </div>
                }
                else if (_settings.PriorityFilterDisplay == FilterDisplay.SelectOptions)
                {
                    <div class="list-group-item" data-search-step-15>
                        <small>@Loc["Priorities"]:</small>
                        <InputSelect class="form-select" aria-label="@Loc["Priorities"]" Value="_settings.SelectedPriority" ValueExpression="() => _settings.SelectedPriority" TValue="Priority?" ValueChanged="SaveSelectedPriority">
                            <option value="">@Loc["All"]</option>
                            <option value="@Priority.None">⊘ @Loc["None"]</option>
                            <option value="@Priority.VeryLow">︾ @Loc["Very low"]</option>
                            <option value="@Priority.Low">﹀ @Loc["Low"]</option>
                            <option value="@Priority.Medium">— @Loc["Medium"]</option>
                            <option value="@Priority.High">︿ @Loc["High"]</option>
                            <option value="@Priority.VeryHigh">︽ @Loc["Very high"]</option>
                        </InputSelect>
                    </div>
                }
            }

            <button class="btn btn-plain border-0 p-0 text-start mx-1 my-2" @onclick="() => ToggleFoldSection(QuerySection.FilterByStatus)" aria-expanded="@(!_settings.FoldSection[QuerySection.FilterByStatus])">
                <small><i class="bi bi-filter" aria-hidden="true"></i> @Loc["Filter by status"]<i class="@($"bi {GetFoldIcon(QuerySection.FilterByStatus)} mx-1")" aria-hidden="true"></i></small>
            </button>

            @if (!_settings.FoldSection[QuerySection.FilterByStatus])
            {
            <div class="list-group-item">
                <div class="position-relative" data-search-step-16>
                    <InputCheckbox id="HideCompletedTasks" class="form-check-input me-1" Value="_settings.HideCompletedTasks" ValueExpression="() => _settings.HideCompletedTasks" ValueChanged="SaveHideCompletedTasks" />
                    <label for="HideCompletedTasks" class="form-check-label stretched-link d-inline">@Loc["Hide completed tasks"]</label>
                </div>
            </div>

            <div class="list-group-item">
                <small>@Loc["Habit interval ratio"]:</small>
                <div data-search-step-17>
                <InputSelect class="form-select" aria-label="@Loc["Habit interval ratio"]" Value="_settings.SelectedRatio" ValueExpression="() => _settings.SelectedRatio" TValue="Ratio" ValueChanged="SaveSelectedRatio">
                    <option value="@Ratio.ElapsedToAverage">@Loc["Elapsed time to average interval"]</option>
                    <option value="@Ratio.ElapsedToDesired">@Loc["Elapsed time to repeat interval"]</option>
                    <option value="@Ratio.AverageToDesired">@Loc["Average interval to repeat interval"]</option>
                </InputSelect>
                </div>
                <div class="position-relative mt-2" data-search-step-18>
                    <InputCheckbox id="ShowItemList" class="form-check-input me-1" Value="_settings.ShowOnlyOverSelectedRatioMin" ValueExpression="() => _settings.ShowOnlyOverSelectedRatioMin" ValueChanged="SaveShowOnlyOverSelectedRatioMin" />
                    <label for="ShowItemList" class="form-check-label stretched-link d-inline">@Loc["Show only habits with interval ratio over"] @_settings.SelectedRatioMin%</label>
                </div>

                <input type="range" class="form-range d-block" aria-label="@Loc["Minimum interval ratio"]" value="@_settings.SelectedRatioMin" @oninput="(ChangeEventArgs args) => SaveSelectedRatioMin(Convert.ToInt32(args.Value))" data-search-step-19 />

                <div class="position-relative mt-2" data-search-step-20>
                    <InputCheckbox id="ShowOnlyUnderSelectedRatioMax" class="form-check-input me-1" Value="_settings.ShowOnlyUnderSelectedRatioMax" ValueExpression="() => _settings.ShowOnlyUnderSelectedRatioMax" ValueChanged="SaveShowOnlyUnderSelectedRatioMax" />
                    <label for="ShowOnlyUnderSelectedRatioMax" class="form-check-label stretched-link d-inline">@Loc["Show only habits with interval ratio under"] @_settings.SelectedRatioMax%</label>
                </div>

                <input type="range" class="form-range d-block" aria-label="@Loc["Maximum interval ratio"]" min="0" max="300" value="@_settings.SelectedRatioMax" @oninput="(ChangeEventArgs args) => SaveSelectedRatioMax(Convert.ToInt32(args.Value))" data-search-step-21 />
            </div>
            }

            <button class="btn btn-plain border-0 p-0 text-start mx-1 my-2" @onclick="() => ToggleFoldSection(QuerySection.Sort)" aria-expanded="@(!_settings.FoldSection[QuerySection.Sort])">
                <small><i class="bi bi-arrow-down-up" aria-hidden="true"></i> @Loc["Sort"]<i class="@($"bi {GetFoldIcon(QuerySection.Sort)} mx-1")" aria-hidden="true"></i></small>
            </button>

            @if (!_settings.FoldSection[QuerySection.Sort])
            {
            <div class="list-group-item" data-search-step-22>
                <small><i class="bi bi-sticky" aria-hidden="true"></i> @Loc["Notes"]:</small>
                <InputSelect class="form-select" aria-label="@Loc["Sort notes"]" Value="_settings.SortBy[ContentType.Note]" ValueExpression="() => _settings.SortBy[ContentType.Note]" ValueChanged="(Sort sort) => SaveSort(ContentType.Note, sort)">
                    <option value="@Sort.Category">@Loc["Category"]</option>
                    <option value="@Sort.Priority">@Loc["Priority"]</option>
                    <option value="@Sort.Title">@Loc["Title"]</option>
                </InputSelect>
            </div>

            <div class="list-group-item" data-search-step-23>
                <small><i class="bi bi-list-task" aria-hidden="true"></i> @Loc["Tasks"]:</small>
                <InputSelect class="form-select" aria-label="@Loc["Sort tasks"]" Value="_settings.SortBy[ContentType.Task]" ValueExpression="() => _settings.SortBy[ContentType.Task]" ValueChanged="(Sort sort) => SaveSort(ContentType.Task, sort)">
                    <option value="@Sort.Category">@Loc["Category"]</option>
                    <option value="@Sort.Priority">@Loc["Priority"]</option>
                    <option value="@Sort.Title">@Loc["Title"]</option>
                    <option value="@Sort.Duration">@Loc["Duration"]</option>
                    <option value="@Sort.ElapsedTime">@Loc["Elapsed time"]</option>
                    <option value="@Sort.PlannedAt">@Loc["Planned at"]</option>
                    <option value="@Sort.TimeSpent">@Loc["Time spent"]</option>
                </InputSelect>
            </div>

            <div class="list-group-item" data-search-step-24>
                <small><i class="bi bi-repeat" aria-hidden="true"></i> @Loc["Habits"]:</small>
                <InputSelect class="form-select" aria-label="@Loc["Sort habits"]" Value="_settings.SortBy[ContentType.Habit]" ValueExpression="() => _settings.SortBy[ContentType.Habit]" ValueChanged="(Sort sort) => SaveSort(ContentType.Habit, sort)">
                    <option value="@Sort.Category">@Loc["Category"]</option>
                    <option value="@Sort.Priority">@Loc["Priority"]</option>
                    <option value="@Sort.Title">@Loc["Title"]</option>
                    <option value="@Sort.Duration">@Loc["Duration"]</option>
                    <option value="@Sort.RepeatInterval">@Loc["Repeat interval"]</option>
                    <option value="@Sort.AverageInterval">@Loc["Average interval"]</option>
                    <option value="@Sort.TimeSpent">@Loc["Time spent"]</option>
                    <option value="@Sort.AverageTimeSpent">@Loc["Average time spent"]</option>
                    <option value="@Sort.ElapsedTime">@Loc["Elapsed time"]</option>
                    <option value="@Sort.SelectedRatio">@Loc["Selected interval ratio"]</option>
                </InputSelect>
            </div>
            }
        </div>
    }
</div>

@if (ClientState.Settings.ShowHelp)
{
    <GuidedTourComponent TourId="search" TourSteps="tourSteps" />
}

@code {
    TourStep[] tourSteps =
    {
        new() { Text = "Search titles and content in Notes, Tasks, and Habits." },
        new() { Text = "Match case when searching." },
        new() { Text = "Clear the search field." },
        new() { Text = "Click here to enter today's date." },
        new() { Text = "Choose how to compare the planned date (<, =, >, ≠)." },
        new() { Text = "Filter by planned date." },
        new() { Text = "Clear the planned date filter." },
        new() { Text = "Click here to enter today's date." },
        new() { Text = "Choose how to compare the done date (<, =, >, ≠)." },
        new() { Text = "Filter by done date." },
        new() { Text = "Clear the done date filter." },
        new() { Text = "Filter tasks by a planned-date range relative to today. Negative days are in the past, positive days are in the future. Leave a field empty for an open-ended range." },
        new() { Text = "Filter tasks and habits by a done-date range relative to today. Negative days are in the past, positive days are in the future. Leave a field empty for an open-ended range." },
        new() { Text = "Filter by categories." },
        new() { Text = "Filter by priorities." },
        new() { Text = "Hide completed tasks." },
        new() { Text = "Choose which Habit interval ratio to display next to the Habit title." },
        new() { Text = "Show only habits with interval ratio over the chosen limit." },
        new() { Text = "Choose the limit." },
        new() { Text = "Show only habits with interval ratio under the chosen limit." },
        new() { Text = "Choose the limit." },
        new() { Text = "Choose how to sort Notes." },
        new() { Text = "Choose how to sort Tasks." },
        new() { Text = "Choose how to sort Habits." },
    };

    private readonly Dictionary<string, object> dataSearchStep1 = new() { ["data-search-step-1"] = "" };
    private readonly Dictionary<string, object> dataSearchStep6 = new() { ["data-search-step-6"] = "" };
    private readonly Dictionary<string, object> dataSearchStep10 = new() { ["data-search-step-10"] = "" };

    private async Task StartTour(string tourId)
    {
        await InvokeAsync(() => GTourService.StartTour(tourId));
    }

    [Parameter]
    public Ref<bool> StateChanged { get; set; } = new();

    [Parameter]
    public EventCallback<bool> StateChangedChanged { get; set; }

    SettingsModel _settings => ClientState.Settings;

    bool? ShowAllCategories => GetShowAllCategories();

    bool? GetShowAllCategories()
    {
        if (_settings.HiddenCategoryIds.Count == 0)
            return true;

        if (_settings.HiddenCategoryIds.Count == CategoryService.Categories?.Count)
            return false;

        return null;
    }

    bool? ShowAllPriorities => GetShowAllPriorities();

    bool? GetShowAllPriorities()
    {
        if (_settings.ShowPriority.Values.All(x => x))
            return true;

        if (!_settings.ShowPriority.Values.Any(x => x))
            return false;

        return null;
    }

    protected override async Task OnInitializedAsync()
    {
        await CategoryService.Initialize();
    }

    async Task UpdateStateChanged()
    {
        StateChanged.Value = !StateChanged.Value;
        await StateChangedChanged.InvokeAsync(StateChanged.Value);
    }

    async Task UpdateSettings()
    {
        await ClientState.UpdateSettings();

        await UpdateStateChanged();
    }

