    const int MaxDayOffset = SettingsModel.MaxDayOffset;

    // Cap the offset so it can never overflow, then keep the range valid:
    // the edited bound wins, the sibling is clamped so from <= to.
    async Task SavePlannedFromDayOffset(int? offset)
    {
        if (offset is int value)
            offset = Math.Clamp(value, -MaxDayOffset, MaxDayOffset);

        _settings.PlannedFromDayOffset = offset;

        if (offset is int from && _settings.PlannedToDayOffset is int to && from > to)
            _settings.PlannedToDayOffset = from;

        await UpdateSettings();
    }

    async Task SavePlannedToDayOffset(int? offset)
    {
        if (offset is int value)
            offset = Math.Clamp(value, -MaxDayOffset, MaxDayOffset);

        _settings.PlannedToDayOffset = offset;

        if (offset is int to && _settings.PlannedFromDayOffset is int from && to < from)
            _settings.PlannedFromDayOffset = to;

        await UpdateSettings();
    }

    async Task SaveDoneFromDayOffset(int? offset)
    {
        if (offset is int value)
            offset = Math.Clamp(value, -MaxDayOffset, MaxDayOffset);

        _settings.DoneFromDayOffset = offset;

        if (offset is int from && _settings.DoneToDayOffset is int to && from > to)
            _settings.DoneToDayOffset = from;

        await UpdateSettings();
    }

    async Task SaveDoneToDayOffset(int? offset)
    {
        if (offset is int value)
            offset = Math.Clamp(value, -MaxDayOffset, MaxDayOffset);

        _settings.DoneToDayOffset = offset;

        if (offset is int to && _settings.DoneFromDayOffset is int from && to < from)
            _settings.DoneFromDayOffset = to;

        await UpdateSettings();
    }

    string RelativeRangePreview((DateTime? Start, DateTime? End) range)
    {
        string? start = range.Start?.ToShortDateString();
        string? end = range.End?.ToShortDateString();

        if (start is not null && end is not null)
            return $"{start} {Loc["to"]} {end}";

        if (start is not null)
            return Loc["Relative range preview from", start];

        if (end is not null)
            return Loc["Relative range preview until", end];

        return string.Empty;
    }

