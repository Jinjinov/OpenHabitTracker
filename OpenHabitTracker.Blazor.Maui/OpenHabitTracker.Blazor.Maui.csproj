<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Android is built on Windows only, so macOS does not need the maui-android workload -->
        <TargetFrameworks>net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-android;$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
        <!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
        <!-- <TargetFrameworks>$(TargetFrameworks);net10.0-tizen</TargetFrameworks> -->

        <!-- Note for MacCatalyst:
            The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
            When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
            The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
            either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
        <!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

        <AssemblyName>OpenHT</AssemblyName>
        <OutputType>Exe</OutputType>
        <RootNamespace>OpenHabitTracker.Blazor.Maui</RootNamespace>
        <UseMaui>true</UseMaui>
        <MauiVersion>10.0.80</MauiVersion>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Blazor Hybrid WebView reads static assets from disk; it never serves the .br/.gz
             precompressed copies the static web asset pipeline generates. Stop emitting them. -->
        <CompressionEnabled>false</CompressionEnabled>

        <!-- Model building is not supported when publishing with NativeAOT. Use a compiled model -->
        <MtouchInterpreter>all</MtouchInterpreter>

        <!-- Display name -->
        <ApplicationTitle>OpenHT</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>net.openhabittracker</ApplicationId>

        <!--
        if ApplicationDisplayVersion != 1.0
        Assets file 'project.assets.json' doesn't have a target for 'net10.0-windows10.0.19041.0'. 
        Ensure that restore has run and that you have included 'net10.0-windows10.0.19041.0' in the TargetFrameworks for your project.
        -->
        <ApplicationDisplayVersion>1.2.4</ApplicationDisplayVersion>
      
        <!-- AndroidManifest.xml : error XA0003: VersionCode 1.0.1 is invalid. It must be an integer value. (Parameter 'VersionCode') -->
        <ApplicationVersion>24</ApplicationVersion>

        <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
        <!--<WindowsPackageType>None</WindowsPackageType>-->

        <TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36</TargetPlatformVersion>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
        <!--<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>-->
      
        <DefaultLanguage>en</DefaultLanguage>
        <GenerateAppInstallerFile>False</GenerateAppInstallerFile>
        <AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
        <AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
        <AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
        <AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
        <GenerateTestArtifacts>True</GenerateTestArtifacts>
        <GenerateTemporaryStoreCertificate>True</GenerateTemporaryStoreCertificate>
        <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    </PropertyGroup>

    <!-- The direct-download APK is arm64-only (every real Android device is arm64-v8a); the
         Google Play AAB keeps both ABIs because Play splits per device. AndroidPackageFormat=apk
         is passed only on the direct APK publish, so this never touches the AAB. -->
    <PropertyGroup Condition="'$(AndroidPackageFormat)' == 'apk'">
        <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#808080" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#808080" BaseSize="128,128" />
    </ItemGroup>

    <PropertyGroup>
        <!-- The Apple SDK bundles every file under Resources; appicon.icon.json is a build input for
             _CompileMacIconComposerIcon below, not something to ship inside the app bundle -->
        <DefaultItemExcludes>$(DefaultItemExcludes);Resources\AppIcon\appicon.icon.json</DefaultItemExcludes>
    </PropertyGroup>

    <!-- macOS 26 draws any asset-catalog app icon inside a gray rounded plate unless the icon comes
         from an Icon Composer .icon file. MauiIcon only ever emits the iOS-idiom appiconset, so the
         Mac Catalyst icon gets plated. Dropping CFBundleIconName would fall back to the good-looking
         appicon.icns, but App Store Connect rejects that key as missing (ITMS-90713).
         So compile a .icon here and overwrite what MauiIcon's actool run produced.
         The .icon bundle is assembled under obj from the same appiconfg.svg the other platforms use,
         so the artwork stays single-sourced; only the layer/material settings live in appicon.icon.json.
         Drop all of this once MauiIcon emits a .icon of its own. -->
    <Target Name="_CompileMacIconComposerIcon"
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and Exists('$(DeviceSpecificIntermediateOutputPath)actool/bundle')"
            AfterTargets="_CompileImageAssets"
            Inputs="Resources\AppIcon\appicon.icon.json;Resources\AppIcon\appiconfg.svg"
            Outputs="$(DeviceSpecificIntermediateOutputPath)appicon.icon.stamp">

        <PropertyGroup>
            <_IconComposerRoot>$(DeviceSpecificIntermediateOutputPath)iconcomposer</_IconComposerRoot>
            <_IconComposerIcon>$(_IconComposerRoot)/appicon.icon</_IconComposerIcon>
            <_IconComposerOut>$(_IconComposerRoot)/out</_IconComposerOut>
        </PropertyGroup>

        <MakeDir Directories="$(_IconComposerIcon)/Assets;$(_IconComposerOut)" />
        <Copy SourceFiles="Resources\AppIcon\appicon.icon.json" DestinationFiles="$(_IconComposerIcon)/icon.json" />
        <Copy SourceFiles="Resources\AppIcon\appiconfg.svg" DestinationFolder="$(_IconComposerIcon)/Assets" />

        <!-- actool's exit code is unreliable, so a compiled Assets.car is the only success signal -->
        <Exec Command="xcrun actool &quot;$(_IconComposerIcon)&quot; --app-icon appicon --compile &quot;$(_IconComposerOut)&quot; --output-partial-info-plist &quot;$(_IconComposerRoot)/partial-info.plist&quot; --minimum-deployment-target $(SupportedOSPlatformVersion) --platform macosx --target-device mac --ui-framework-family uikit"
              StandardOutputImportance="low" IgnoreExitCode="true" />

        <Error Condition="!Exists('$(_IconComposerOut)/Assets.car')"
               Text="actool did not produce an Assets.car from Resources\AppIcon\appicon.icon.json" />

        <Copy SourceFiles="$(_IconComposerOut)/Assets.car;$(_IconComposerOut)/appicon.icns"
              DestinationFolder="$(DeviceSpecificIntermediateOutputPath)actool/bundle" />

        <Touch Files="$(DeviceSpecificIntermediateOutputPath)appicon.icon.stamp" AlwaysCreate="true" />
        <ItemGroup>
            <FileWrites Include="$(DeviceSpecificIntermediateOutputPath)appicon.icon.stamp" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Maui.Core" Version="14.2.2" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
        <PackageReference Include="Plugin.Maui.AppRating" Version="1.2.3" />
    </ItemGroup>

    <!-- CVE-2025-6965 override: EF Core Sqlite still pins the vulnerable 2.1.11 native SQLite builds;
         one lib pin per platform TFM here, and one per desktop host csproj
         (never in the shared EFCore project - see the note there);
         remove when Microsoft.EntityFrameworkCore.Sqlite references 2.1.12+ itself -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.12" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.ios" Version="2.1.12" />
    </ItemGroup>
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\OpenHabitTracker.Blazor.Auth\OpenHabitTracker.Blazor.Auth.csproj" />
        <ProjectReference Include="..\OpenHabitTracker.EntityFrameworkCore\OpenHabitTracker.EntityFrameworkCore.csproj" />
    </ItemGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('-ios')) and '$(Configuration)' == 'Release'">
        <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>

        <CodesignKey>Apple Distribution: Urban Dzindzinovic (53V66WG4KU)</CodesignKey>
        <CodesignProvision>openhabittracker.ios</CodesignProvision>
    </PropertyGroup>

    <PropertyGroup Condition="$(TargetFramework.Contains('-maccatalyst')) and '$(Configuration)' == 'Release'">
        <!--<CodesignEntitlement>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlement>-->

        <MtouchLink>SdkOnly</MtouchLink>
        <EnableCodeSigning>True</EnableCodeSigning>
        <EnablePackageSigning>true</EnablePackageSigning>
        <CreatePackage>true</CreatePackage>
        <CodesignKey>Apple Distribution: Urban Dzindzinovic (53V66WG4KU)</CodesignKey>
        <CodesignProvision>openhabittracker.macos</CodesignProvision>
        <CodesignEntitlements>Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
        <PackageSigningKey>3rd Party Mac Developer Installer: Urban Dzindzinovic (53V66WG4KU)</PackageSigningKey>

        <!--<CodesignKey>Apple Distribution: Urban Dzindzinovic (53V66WG4KU)</CodesignKey>-->
        <!--<CodesignProvision>openhabittracker.macos</CodesignProvision>-->

        <!--<CodesignKey>3rd Party Mac Developer Application: Urban Dzindzinovic (53V66WG4KU)</CodesignKey>-->
        <!--<PackageSigningKey>3rd Party Mac Developer Installer: Urban Dzindzinovic (53V66WG4KU)</PackageSigningKey>-->

        <!--<CodesignKey>Developer ID Application: Urban Dzindzinovic (53V66WG4KU)</CodesignKey>-->
        <!--<CodesignProvision>openhabittracker.developer</CodesignProvision>-->
        <!--<PackageSigningKey>Developer ID Installer: Urban Dzindzinovic (53V66WG4KU)</PackageSigningKey>-->

        <!--<EnableCodeSigning>True</EnableCodeSigning>-->
        <!--<EnablePackageSigning>true</EnablePackageSigning>-->
        <!--<CreatePackage>true</CreatePackage>-->
        <!--<ProvisionType>Manual</ProvisionType>-->
        <!--<UseHardenedRuntime>true</UseHardenedRuntime>-->
    </PropertyGroup>

</Project>
