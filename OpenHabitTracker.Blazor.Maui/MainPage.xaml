<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:oht="clr-namespace:OpenHabitTracker.Blazor;assembly=OpenHabitTracker.Blazor"
             x:Class="OpenHabitTracker.Blazor.Maui.MainPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}"
             SafeAreaEdges="Container, Container, Container, None">

    <!-- Bottom None draws the page under the Android navigation bar and the iOS home indicator;
         the scroll containers in app.css end with a spacer of that height so the page stays reachable.
         Gesture navigation would hide a missing spacer (transparent 24 dp strip), three-button navigation
         would not (an opaque 48 dp bar covers the end of every page), so test on three-button navigation.
         Container instead reserves the strip and paints it in PageBackgroundColor. -->

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type oht:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
